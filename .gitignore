# macOS
.DS_Store

# Raw/intermediate data and per-sample outputs -- large, regenerable from
# run_all.sh / run_markers.sh, and far too big for git (contigs/ alone is 70GB,
# QC/ and blast/ are hundreds of GB each). Only code, config, metadata and docs
# are tracked; see README_analysis.md and README_markers.md for how to
# regenerate everything under these paths.
taxdump/
repaired_QC/
reads_with_missing_contigs/
QC/
mapping/
lca/
contigs/
contigs_with_missing_reads/
blast/
# extracting_pathogens/: data ignored, but track the audit scripts and
# reports' sources, plus the one ids file curate_tick_repeat_contigs.py reads
extracting_pathogens/**
!extracting_pathogens/**/
!extracting_pathogens/**/*.py
!extracting_pathogens/**/*.sh
!extracting_pathogens/**/*.qmd
!extracting_pathogens/**/*.R
!extracting_pathogens/north_shore_virus/are_these_real/cds.ids
results/

# Conda envs are recreated from env/*.yml, not stored
env/*/

# Bulky run logs -- not source, not needed to reproduce
logs/
code/logs/

# Python bytecode cache
__pycache__/
*.pyc

# Raw sequencing reads (hundreds of GB)
raw_data/

# Rendered report: 38 MB self-contained HTML, rebuilt from the .qmd
report/*.html
